# main.py reads process environment variables. It does not load this file.
# Before start: export $(grep -v '^#' .env | xargs)

# Required. Generate with:
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
# Then set the printed value here and export it as IMESSAGE_API_TOKEN.
IMESSAGE_API_TOKEN=replace-with-a-long-random-secret

# Bind address used by `python main.py`. Default is loopback.
# Reaching this API from another machine requires a tunnel or reverse proxy.
HOST=127.0.0.1

# Optional comma-separated chat.guid allow-list. Empty keeps every chat readable
# and logs a startup warning.
ALLOWED_CHAT_GUIDS=

# Send routes stay off unless this is true. They return 403 and do not run osascript.
ENABLE_SEND=false
