# Required — used as X-API-Token on API requests
IMESSAGE_API_TOKEN=replace-with-a-long-random-secret

# Read-only relay (python relay.py). python-dotenv is optional.
# CHAT_DB=~/Library/Messages/chat.db
# STATE_FILE=~/.imessage-relay-state.json
# POLL_INTERVAL=30
# MAX_PER_RUN=100
# BACKFILL=0
# WEBHOOK_AUTH_SCHEME=Bearer
# AUTH_HEADER_RAW=
ALLOWED_CHAT_GUIDS=chat-guid-1,chat-guid-2
WEBHOOK_URL=https://example.com/hooks/imessage
WEBHOOK_KEY=replace-with-webhook-key
